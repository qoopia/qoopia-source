# Non-secret inputs consumed by docker compose and the release validator.
# Copy outside the source tree, replace every example, and keep the deployed
# release record with the operator-approved change ticket.
QOOPIA_IMAGE_REF=registry.example/qoopia@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
QOOPIA_RELEASE_SHA=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
QOOPIA_ROOT=/srv/qoopia
QOOPIA_SERVER_ROLE=canonical
QOOPIA_PORT=3738
QOOPIA_AUTO_MIGRATE=false
