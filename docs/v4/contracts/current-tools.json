    {
      "availability": "always",
      "description": "Full-text search across notes, activity log, and session messages. Returns results with complete text (no truncation). Default is hybrid-only (FTS5 + bge-m3 vector channel fused via RRF, ~50ms, no external sidecar). Opt-in `deep=true` adds a cross-encoder rerank stage (~1.5s) that reorders top candidates by pair-wise relevance; `deep_llm=true` instead invokes the Claude-Haiku LLM judge (~5-17s, sharper on tricky mono-term / cross-language queries). Both rerank paths are bounded by their timeout env and fall back to raw RRF order on sidecar failure.",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "cross_workspace": {
            "description": "Honored only for privileged agents (Claude).",
            "type": "boolean"
          },
          "deep": {
            "description": "Cross-encoder rerank on top of the hybrid pool (~1.5s). Default OFF unless server has QOOPIA_RERANK_DEFAULT_DEEP=1. Set true to opt in per call; set false to force raw RRF order even when the env default is on.",
            "type": "boolean"
          },
          "deep_llm": {
            "description": "LLM-judge rerank via Claude Haiku sidecar (~5-15s). Opt-in for tricky / high-precision recall; overrides `deep`.",
            "type": "boolean"
          },
          "include_archived": {
            "description": "Include notes whose metadata.status='archived'. Default false — archived rows hidden to keep results focused.",
            "type": "boolean"
          },
          "limit": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "project_id": {
            "type": "string"
          },
          "query": {
            "description": "Full-text keywords. Use multiple terms to narrow.",
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "description": "notes (default) | activity (audit log) | sessions (conversation messages) | all (union of the three).",
            "enum": [
              "notes",
              "activity",
              "sessions",
              "all"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
