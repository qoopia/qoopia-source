          "target_note_id",
          "expected_target_updated_at_ms",
          "idempotency_key"
        ]
      },
      "result_schema": {
        "$ref": "https://qoopia.local/contracts/v4-response-schemas.json#/definitions/NoteSupersedeResponse"
      }
    },
