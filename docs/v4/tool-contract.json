        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_note_id": {
            "type": "string",
            "minLength": 1
          },
          "target_note_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_updated_at_ms": {
            "type": "integer",
            "minimum": 1
          },
          "metadata": {
            "type": "object",
