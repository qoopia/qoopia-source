  "compatibility": {
    "baseline_required_fields_unchanged": true,
    "baseline_defaults_unchanged_when_flags_off": true,
    "baseline_response_envelopes_unchanged": true,
    "deprecated_compat_overlay_extended": false,
    "unknown_fields_policy": "server Zod schemas remain authoritative",
    "feature_disabled_policy": "An explicitly requested gated option returns FEATURE_DISABLED; it is never silently enabled or ignored.",
    "mcp_success_envelope": "content[0].text contains one JSON value",
    "mcp_error_envelope": "isError=true with stable CODE: message text; no internal stack or secret",
    "oauth_risk_mapping": {
      "read": [
        "mcp:read",
        "mcp:write",
        "mcp:admin"
      ],
      "write-low": [
        "mcp:write",
        "mcp:admin"
      ],
      "write-destructive": [
        "mcp:admin"
      ],
      "admin": [
        "mcp:admin"
      ]
    }
  }
}
