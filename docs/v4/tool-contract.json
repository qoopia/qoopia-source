{
  "schema_version": 2,
  "target_version": "4.0.0",
  "migration_target": 32,
  "response_schema_registry": {
    "id": "https://qoopia.local/contracts/v4-response-schemas.json",
    "path": "docs/v4/contracts/v4-response-schemas.json",
    "draft": "http://json-schema.org/draft-07/schema#"
  },
  "authorization_contract": {
    "evaluation_order": [
      "authenticated",
      "tool_profile",
      "oauth_scope",
      "instance_role",
      "workspace",
      "resource_visibility",
      "capability",
      "transaction_recheck"
    ],
    "admin_agent_types": [
      "owner",
      "steward"
    ],
    "private_note_bypass_agent_types": [
      "owner",
      "steward",
      "claude-privileged"
    ],
    "unknown_agent_type_policy": "no special capability",
    "unknown_profile_scope_or_instance_policy": "deny",
    "workspace_source": "AuthContext.workspace_id only; request IDs never widen workspace",
    "resource_rules": {
      "base_note_visible": "The named note is visible under current workspace, deleted-state, and private-note rules; NOT_FOUND is used when visibility would leak existence.",
      "relation_endpoints_visible": "A relation row is returned only when both endpoint notes are visible to the caller.",
      "notes_mutable": "Both notes are in AuthContext.workspace_id and each passes the existing note-service mutation/private-owner checks.",
      "session_range_visible": "The session and every source message in the inclusive range are visible to the caller in AuthContext.workspace_id.",
      "run_initiator_or_admin": "The caller initiated the extraction run or has owner/steward capability; candidates still expose only authorized source references.",
      "review_capability": "The caller is the run initiator or owner/steward; accept/edit of rule, finance, owner-approved decision, or legal-classified content requires owner/steward.",
      "trace_caller_or_admin": "The trace caller matches AuthContext.agent_id or the caller has owner/steward capability; every returned item is re-filtered through current result visibility.",
      "feedback_note_visible": "The note is currently visible. If trace_id is supplied, the unexpired trace belongs to AuthContext.agent_id and contains that note; pin/unpin additionally requires owner/steward.",
      "workspace_export_admin": "Caller has owner/steward capability; export scope is exactly AuthContext.workspace_id and cannot be selected by request input.",
      "workspace_import_admin": "Caller has owner/steward capability; target_workspace_id must equal AuthContext.workspace_id and artifact resolution is confined to the sanctioned export root.",
      "delivery_recipient_only": "The receipt consumer_id is derived only from AuthContext.agent_id. Callers cannot select another consumer or workspace; message_id may only narrow the caller's own receipt."
    }
  },
  "recall_optional_properties": {
    "latest_only": {
      "type": "boolean",
      "description": "Return active supersede heads only. Effective default remains false until QOOPIA_V4_LATEST_ONLY is enabled. include_history=true forces false when omitted and rejects explicit true."
    },
    "include_history": {
      "type": "boolean",
      "default": false,
      "description": "Relation audit mode. true requires include_archived=true, forces effective latest_only=false when omitted, and is incompatible with explicit latest_only=true."
    },
    "explain": {
      "type": "boolean",
      "default": false,
      "description": "Return bounded score components and reason codes for visible results only. Requires QOOPIA_V4_RECALL_EXPLAIN."
    },
    "trace": {
      "type": "boolean",
      "default": false,
      "description": "Persist a privacy-safe bounded trace and return its opaque ID. Requires QOOPIA_V4_RECALL_EXPLAIN."
    },
    "lifecycle": {
      "type": "boolean",
      "description": "Per-call lifecycle override. true requires QOOPIA_V4_LIFECYCLE; false disables lifecycle for this call."
    }
  },
  "new_tools": [
    {
      "name": "note_relation_list",
      "description": "List visible V4 relations for one note after workspace and private-note authorization.",
      "risk": "read",
      "availability": "QOOPIA_V4_RELATIONS",
      "authorization": {
        "oauth_scope_any": [
          "mcp:read",
          "mcp:write",
          "mcp:admin"
        ],
        "tool_profile_any": [
          "read-only",
          "no-destructive",
          "full"
        ],
        "agent_type_any": [
          "authenticated"
        ],
        "instance_role_any": [
          "canonical",
          "legacy-readonly"
        ],
        "resource_rules": [
          "base_note_visible",
          "relation_endpoints_visible"
        ],
        "transaction_recheck": false
      },
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "note_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "any",
              "outgoing",
              "incoming"
            ],
            "default": "any"
          },
          "relation_types": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "supersedes",
                "conflicts_with",
                "supports",
                "derived_from"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "note_id"
        ]
      },
      "result_schema": {
        "$ref": "https://qoopia.local/contracts/v4-response-schemas.json#/definitions/NoteRelationListResponse"
      }
    },
    {
      "name": "note_supersede",
