  "backup": {
    "normal_rpo_seconds_max": 86400,
    "pre_mutation_backup_age_seconds_max": 1800
  },
  "token_efficiency": {
    "rule": "Accuracy may not improve solely by exceeding the frozen top-k or context-token budget.",
    "report_fields": ["context_tokens_per_query", "answer_accuracy", "top_k", "mode"]
  }
}
