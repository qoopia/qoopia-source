{
  "schema_version": 1,
  "baseline_rule": "When the frozen V3 baseline is better than an absolute limit, the candidate may regress by at most 10 percent.",
  "baseline_rule_gate": {
    "candidate": "v4-flags-off",
    "quantile": "p50",
    "max_ratio": 1.1,
    "noise_floor_ms": 1,
    "scope": "Only flags-off serves the same request as V3 (flags-on adds hybrid, explain and lifecycle and has absolute budgets). Medians come from the same run; p95/p99 of three runs are too noisy for a ratio and are held to the absolute limits."
  },
  "latency_ms": {
